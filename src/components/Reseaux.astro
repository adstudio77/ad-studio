---
const points = [
  "Création de contenu photo & vidéo pour vos réseaux",
  "Gestion de vos comptes au quotidien",
  "Consulting stratégie & ligne éditoriale",
];
---
<section id="reseaux" class="reseaux">
  <div class="wrap reseaux__inner">
    <h2 class="reseaux__title">
      Vos réseaux, <span>notre studio</span>.
    </h2>
    <div class="reseaux__body">
      <ul class="reseaux__list">
        {points.map((p) => (
          <li>
            <span class="reseaux__icon">✺</span>
            {p}
          </li>
        ))}
      </ul>
      <div class="reseaux__cta">
        <p>
          On produit le contenu dans nos studios photo &amp; podcast, puis on vous
          aide à le faire vivre sur vos réseaux — à la carte ou en continu.
        </p>
        <a href="#contact" class="btn btn-pink">En discuter</a>
      </div>
    </div>
  </div>
</section>

<style>
  .reseaux {
    background: var(--orange);
    padding: 90px 0;
    color: var(--ink);
  }
  .reseaux__title {
    font-size: clamp(32px, 5vw, 56px);
    text-transform: uppercase;
    margin-bottom: 48px;
  }
  .reseaux__title span {
    color: var(--white);
    -webkit-text-stroke: 1.5px var(--ink);
  }
  .reseaux__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    border-top: 2px solid var(--ink);
    padding-top: 40px;
  }
  .reseaux__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-weight: 700;
    font-size: 19px;
  }
  .reseaux__list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .reseaux__icon { color: var(--pink); flex-shrink: 0; }
  .reseaux__cta p {
    font-size: 16.5px;
    line-height: 1.6;
    max-width: 420px;
    margin-bottom: 24px;
  }

  @media (max-width: 820px) {
    .reseaux__body { grid-template-columns: 1fr; }
  }
</style>
