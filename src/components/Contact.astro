---
const services = [
  "Studio photo — fonds & lumière",
  "Studio photo — avec photographe",
  "Studio photo — photographe + DA",
  "Studio podcast — sans caméra",
  "Studio podcast — avec captation",
  "Studio podcast — captation + DA",
  "Réseaux sociaux & contenu",
  "Salle de réunion",
  "Je ne sais pas encore",
];
---
<section id="contact" class="contact">
  <div class="wrap contact__inner">
    <div class="contact__text">
      <p class="eyebrow contact__label">Devis</p>
      <h2 class="contact__title">Un projet ?<br />Parlons-en.</h2>
      <p class="contact__desc">
        Chaque prestation AD STUDIO est chiffrée sur mesure. Décrivez votre besoin,
        on revient vers vous avec un devis sous 48h.
      </p>
      <div class="contact__info">
        <p><strong>Adresse</strong><br />Boulevard Michael Faraday, 77700 Serris</p>
        <!-- TODO AD STUDIO : remplacer par vos coordonnées réelles -->
        <p><strong>Email</strong><br /><a href="mailto:contact@ad-studio-serris.fr">contact@ad-studio-serris.fr</a></p>
        <p><strong>Téléphone</strong><br /><a href="tel:+33000000000">+33 (0)0 00 00 00 00</a></p>
      </div>
    </div>

    <!-- TODO AD STUDIO : brancher ce formulaire sur un service d'envoi (Formspree, Resend, etc.) -->
    <form class="contact__form" action="mailto:contact@ad-studio-serris.fr" method="post" enctype="text/plain">
      <div class="field-row">
        <label>
          Nom
          <input type="text" name="nom" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
      </div>
      <label>
        Téléphone
        <input type="tel" name="telephone" />
      </label>
      <label>
        Service souhaité
        <select name="service">
          {services.map((s) => <option>{s}</option>)}
        </select>
      </label>
      <label>
        Votre projet
        <textarea name="message" rows="4" placeholder="Date envisagée, format, besoins particuliers..."></textarea>
      </label>
      <button type="submit" class="btn btn-pink contact__submit">Envoyer ma demande</button>
    </form>
  </div>
</section>

<style>
  .contact {
    background: var(--white);
    padding: 100px 0 110px;
  }
  .contact__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
  }
  .contact__label { color: var(--pink); margin-bottom: 18px; }
  .contact__title {
    font-size: clamp(34px, 5vw, 58px);
    text-transform: uppercase;
    margin-bottom: 22px;
  }
  .contact__desc {
    font-size: 16.5px;
    line-height: 1.6;
    max-width: 420px;
    margin-bottom: 36px;
  }
  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 15px;
  }
  .contact__info a { color: var(--pink); text-decoration: none; font-weight: 700; }
  .contact__info strong {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(35,31,32,0.5);
  }

  .contact__form {
    background: var(--ink);
    border-radius: var(--radius);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .contact__form label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: rgba(255,255,255,0.7);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .contact__form input,
  .contact__form select,
  .contact__form textarea {
    background: #2c2829;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 10px;
    padding: 12px 14px;
    color: var(--white);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
  }
  .contact__form input:focus,
  .contact__form select:focus,
  .contact__form textarea:focus {
    outline: 2px solid var(--pink);
    outline-offset: 1px;
  }
  .contact__submit {
    margin-top: 6px;
    align-self: flex-start;
  }

  @media (max-width: 900px) {
    .contact__inner { grid-template-columns: 1fr; }
    .field-row { grid-template-columns: 1fr; }
  }
</style>
