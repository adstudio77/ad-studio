---
const items = ["Studio Photo", "Studio Podcast", "Salle de Réunion", "Direction Artistique", "Réseaux Sociaux", "Serris — 77"];
---
<div class="marquee">
  <div class="marquee__track">
    {[...items, ...items].map((item) => (
      <div class="marquee__item">
        {item} <span class="dot">✺</span>
      </div>
    ))}
  </div>
</div>
