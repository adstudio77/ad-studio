---
const slides = [
  { image: "/stage.png" },
  { image: "/armanda.png" },
  { image: "/orange.png" },
];
---
<section id="projets" class="projets">
  <div class="wrap">
    <p class="eyebrow projets__label">Portfolio</p>
    <h2 class="projets__title">Nos Projets.</h2>

    <div class="slideshow" id="slideshow">
      <div class="slideshow__track" id="slideshowTrack">
        {slides.map((slide) => (
          <div class="slideshow__slide">
            <img src={slide.image} alt="" />
          </div>
        ))}
      </div>

      <button type="button" class="slideshow__nav slideshow__nav--prev" id="prevBtn" aria-label="Précédent">‹</button>
      <button type="button" class="slideshow__nav slideshow__nav--next" id="nextBtn" aria-label="Suivant">›</button>

      <div class="slideshow__dots" id="slideshowDots">
        {slides.map((_, i) => (
          <button type="button" class="slideshow__dot" data-index={i} aria-label={`Aller à la diapositive ${i + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .projets {
    background: var(--white);
    padding: 96px 0;
  }

  .projets__label {
    color: var(--pink);
    margin-bottom: 18px;
  }

  .projets__title {
    font-size: clamp(34px, 5vw, 58px);
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 48px;
  }

  .slideshow {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 3px solid var(--ink);
  }

  .slideshow__track {
    display: flex;
    transition: transform 0.4s ease;
  }

  .slideshow__slide {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: 16 / 9;
  }

  .slideshow__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #eee;
  }

  .slideshow__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.9);
    color: var(--ink);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slideshow__nav:hover {
    background: var(--pink);
    color: var(--white);
  }

  .slideshow__nav--prev { left: 16px; }
  .slideshow__nav--next { right: 16px; }

  .slideshow__dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
  }

  .slideshow__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 0;
  }

  .slideshow__dot.active {
    background: var(--pink);
  }

  @media (max-width: 640px) {
    .slideshow__nav {
      width: 38px;
      height: 38px;
      font-size: 20px;
    }
  }
</style>

<script>
  const track = document.getElementById('slideshowTrack');
  const dots = document.querySelectorAll('.slideshow__dot');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const total = dots.length;
  let current = 0;

  function goTo(index) {
    current = (index + total) % total;
    track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
  }

  prevBtn?.addEventListener('click', () => goTo(current - 1));
  nextBtn?.addEventListener('click', () => goTo(current + 1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

  goTo(0);
</script>
